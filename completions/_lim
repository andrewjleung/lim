if [ "$funcstack[1]" = "_lim" ]; then
    _lim "$@"
else
    compdef _lim lim
fi

_lim_event_paths() {
  local -a all_paths
  all_paths=(${(f)"$(lim _paths 2>/dev/null)"})

  local current="${words[$CURRENT]}"
  local prefix=""
  if [[ "$current" == *"."* ]]; then
    prefix="${current%.*}."
  fi

  local -a candidates
  local p rest next
  for p in $all_paths; do
    if [[ "$p" == ${prefix}* ]]; then
      rest="${p#$prefix}"
      next="${rest%%.*}"
      candidates+=("${prefix}${next}")
    fi
  done

  compadd -S "" ${(u)candidates}
}
